generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegionStatus {
  ok
  dudoso
  corregido
}

enum ProcessStatus {
  /// Estado por defecto del sync: nada sale a OCR/LLM hasta que el usuario pida analizar
  sin_analizar
  pendiente
  procesando
  listo
  necesita_revision
  error
}

enum JobStatus {
  pendiente
  procesando
  listo
  error
}

/// Cola de trabajos en PostgreSQL (claim con FOR UPDATE SKIP LOCKED).
model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(pendiente)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  /// Único opcional: evita encolar dos veces el mismo trabajo lógico
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

/// Usuario de la app (login con correo + contraseña, independiente de Microsoft).
model User {
  id                String         @id @default(uuid())
  /// Siempre en minúsculas
  email             String         @unique
  nombre            String
  /// argon2id
  passwordHash      String
  createdAt         DateTime       @default(now())
  passwordChangedAt DateTime       @default(now())
  mailAccount       MailAccount?
  refreshTokens     RefreshToken[]
}

/// Refresh token opaco de la sesión (solo se guarda su hash SHA-256). Rotación por familia.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model MailAccount {
  id          String           @id @default(uuid())
  /// Dueño (una cuenta de Outlook por usuario). Nulo en cuentas previas a la fase 8: se adopta con el CLI user:create.
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String           @unique
  /// Refresh token cifrado (AES-GCM)
  tokenEnc    String?
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  threads     Thread[]
  folderSyncs MailFolderSync[]
}

/// Un deltaLink por carpeta de Graph (inbox, sentitems).
model MailFolderSync {
  id        String      @id @default(uuid())
  accountId String
  folder    String
  deltaLink String?
  updatedAt DateTime    @updatedAt
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, folder])
}

model Thread {
  id                  String             @id @default(uuid())
  accountId           String
  conversationId      String
  subject             String
  status              ProcessStatus      @default(sin_analizar)
  /// Reanálisis automático cuando llegan mensajes nuevos a un hilo ya analizado
  seguimiento         Boolean            @default(false)
  /// Llegaron mensajes/adjuntos después del último análisis (y no hay seguimiento)
  tieneMensajesNuevos Boolean            @default(false)
  contentHash         String?
  lastMessageAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  account             MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages            Message[]
  syntheses           Synthesis[]
  reportRows          ReportRow[]
  reportData          ThreadReportData[]
  hospitalEvents      HospitalEvent[]

  @@unique([accountId, conversationId])
}

model Message {
  id          String       @id @default(uuid())
  threadId    String
  graphId     String       @unique
  from        String
  to          String[]
  cc          String[]
  subject     String
  bodyText    String
  /// true si el remitente es el correo de la cuenta (mensaje enviado por mí)
  isFromMe    Boolean      @default(false)
  receivedAt  DateTime
  createdAt   DateTime     @default(now())
  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([threadId, receivedAt])
}

model Attachment {
  id         String        @id @default(uuid())
  messageId  String
  graphId    String?
  filename   String
  mimeType   String
  size       Int
  storageKey String
  sha256     String
  status     ProcessStatus @default(pendiente)
  createdAt  DateTime      @default(now())
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pages      OcrPage[]

  @@index([sha256])
}

model OcrPage {
  id           String      @id @default(uuid())
  attachmentId String
  /// Denormalizado de Attachment.sha256: un PDF repetido comparte un solo juego de páginas
  sha256       String
  pageNumber   Int
  imageKey     String
  width        Int
  height       Int
  text         String?
  /// Motor que produjo el OCR (local | textract)
  engine       String?
  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  regions      OcrRegion[]

  @@unique([attachmentId, pageNumber])
  @@unique([sha256, pageNumber])
}

model OcrRegion {
  id         String       @id @default(uuid())
  pageId     String
  /// Caja normalizada 0..1
  x          Float
  y          Float
  w          Float
  h          Float
  text       String
  confidence Float
  status     RegionStatus @default(ok)
  userText   String?
  /// Origen del texto vigente: ocr | vision | usuario
  source     String       @default("ocr")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  page       OcrPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status])
}

model Synthesis {
  id                   String   @id @default(uuid())
  threadId             String
  version              Int
  markdown             String
  inputHash            String
  /// Modelo LLM que generó el texto
  model                String?
  /// Plantilla usada (id y versión) al generar
  templateId           String?
  templateVersion      Int?
  /// Ids de TODOS los mensajes del hilo que cubre esta versión (acumulativo). "Mensajes nuevos" =
  /// mensajes del hilo cuyo id no está aquí. Vacío en versiones anteriores a la síntesis incremental.
  coveredMessageIds    Json     @default("[]")
  /// 'full' (hilo completo) | 'incremental' (síntesis previa + novedades)
  mode                 String   @default("full")
  /// Síntesis previa sobre la que se actualizó (solo mode = incremental)
  baseSynthesisId      String?
  /// Tokens estimados enviados al LLM (suma de llamadas) para auditar costo; sin contenido
  inputTokensEstimados Int?
  createdAt            DateTime @default(now())
  thread               Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, version])
}

model Template {
  id        String   @id @default(uuid())
  name      String
  /// Tipo de plantilla: 'resumen' (síntesis del ticket) | 'whatsapp' (formato del mensaje). Ver template-kinds.ts
  kind      String   @default("resumen")
  /// Versión incremental por kind; solo una fila activa a la vez por kind (las demás son historial)
  version   Int      @default(1)
  markdown  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Reporte diario en Excel (censo de pacientes hospitalizados). El archivo vive en RustFS (`storageKey`).
model Report {
  id                  String      @id @default(uuid())
  /// 'YYYY-MM-DD' en la zona horaria configurada (`reporte.zona`)
  fecha               String
  /// 'manual' | 'programado'
  trigger             String
  /// 'generando' | 'listo' | 'error'
  status              String      @default("generando")
  storageKey          String?
  fileName            String?
  /// Versión de la plantilla 'reporte' con la que se generó
  templateVersion     Int?
  /// Nombres de las columnas de la plantilla usadas (para mostrar las filas sin abrir el Excel)
  columnas            Json        @default("[]")
  totalHospitalizados Int         @default(0)
  totalConNovedad     Int         @default(0)
  totalAltas          Int         @default(0)
  /// En desuso: el reporte solo incluye hilos analizados; ya no se escribe ni se expone (se conserva para no migrar)
  totalSinAnalizar    Int         @default(0)
  /// Progreso: hilos procesados / total a procesar
  procesados          Int         @default(0)
  total               Int         @default(0)
  error               String?
  createdAt           DateTime    @default(now())
  finishedAt          DateTime?
  rows                ReportRow[]

  @@index([fecha])
  @@index([createdAt])
}

/// Fila del censo: un paciente (hilo) en un reporte. Sin contenido de correos: solo lo extraído de la síntesis.
model ReportRow {
  id             String    @id @default(uuid())
  reportId       String
  threadId       String
  synthesisId    String?
  /// 'hospitalizado' | 'alta' | 'otro' (otro = extracción incompleta)
  estado         String
  novedad        Boolean   @default(false)
  /// Qué cambió respecto al reporte anterior (texto corto)
  novedadTexto   String?
  /// El resumen no cubre mensajes recientes (hay mensajes sin analizar)
  desactualizado Boolean   @default(false)
  /// columna -> valor
  data           Json      @default("{}")
  extraccionOk   Boolean   @default(true)
  /// Fecha de la síntesis vigente (última actualización del resumen)
  actualizadoEn  DateTime?
  createdAt      DateTime  @default(now())
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  thread         Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([threadId, createdAt])
}

/// Caché de extracción: misma síntesis + mismas columnas => no se vuelve a llamar al LLM.
model ThreadReportData {
  id              String   @id @default(uuid())
  threadId        String
  synthesisId     String
  templateVersion Int
  /// 'hospitalizado' | 'alta' | 'otro'
  estado          String
  novedadTexto    String?
  data            Json     @default("{}")
  createdAt       DateTime @default(now())
  thread          Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, synthesisId, templateVersion])
}

/// Bitácora de eventos de hospitalización: el usuario confirma (tras revisar el borrador de la IA)
/// una actualización de un hilo analizado; alimenta la hoja «Eventos» del Excel.
model HospitalEvent {
  id              String   @id @default(uuid())
  threadId        String
  /// Versión de síntesis de origen: un evento por (hilo, síntesis)
  synthesisId     String
  fechaEvento     DateTime
  /// 'YYYY-MM-DD' de fechaEvento en la zona `reporte.zona`
  fecha           String
  /// 'hospitalizado' | 'alta' | 'otro'
  estado          String
  novedadTexto    String?
  /// columna -> valor (editado por el usuario)
  data            Json     @default("{}")
  /// Nombres de columnas usados al crear el evento (orden de la plantilla)
  columnas        Json     @default("[]")
  templateVersion Int?
  createdAt       DateTime @default(now())
  thread          Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, synthesisId])
  @@index([threadId, fechaEvento])
  @@index([fecha])
}

/// Uso de IA por llamada (LLM) o por página (OCR de pago). SOLO cifras: nunca contenido de
/// correos, PDFs ni pacientes. El costo se calcula al consultar con los precios de `ia.precios`.
model LlmUsage {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  /// llm | ocr
  kind             String
  provider         String
  /// En OCR: textract-detect | textract-analyze | azure-read
  model            String
  /// LlmTask o 'ocr'
  task             String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cachedTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  pages            Int      @default(0)
  /// true si el proveedor no devolvió uso y se estimó (len/4)
  estimated        Boolean  @default(false)
  /// Ticket asociado (sin FK: el registro sobrevive al borrado del hilo)
  threadId         String?

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([threadId])
}
