generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegionStatus {
  ok
  dudoso
  corregido
}

enum ProcessStatus {
  /// Estado por defecto del sync: nada sale a OCR/LLM hasta que el usuario pida analizar
  sin_analizar
  pendiente
  procesando
  listo
  necesita_revision
  error
}

enum JobStatus {
  pendiente
  procesando
  listo
  error
}

/// Cola de trabajos en PostgreSQL (claim con FOR UPDATE SKIP LOCKED).
model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(pendiente)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  /// Único opcional: evita encolar dos veces el mismo trabajo lógico
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

/// Usuario de la app (login con correo + contraseña, independiente de Microsoft).
model User {
  id                String         @id @default(uuid())
  /// Siempre en minúsculas
  email             String         @unique
  nombre            String
  /// argon2id
  passwordHash      String
  createdAt         DateTime       @default(now())
  passwordChangedAt DateTime       @default(now())
  mailAccount       MailAccount?
  refreshTokens     RefreshToken[]
}

/// Refresh token opaco de la sesión (solo se guarda su hash SHA-256). Rotación por familia.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model MailAccount {
  id          String           @id @default(uuid())
  /// Dueño (una cuenta de Outlook por usuario). Nulo en cuentas previas a la fase 8: se adopta con el CLI user:create.
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String           @unique
  /// Refresh token cifrado (AES-GCM)
  tokenEnc    String?
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  threads     Thread[]
  folderSyncs MailFolderSync[]
}

/// Un deltaLink por carpeta de Graph (inbox, sentitems).
model MailFolderSync {
  id        String      @id @default(uuid())
  accountId String
  folder    String
  deltaLink String?
  updatedAt DateTime    @updatedAt
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, folder])
}

model Thread {
  id                  String        @id @default(uuid())
  accountId           String
  conversationId      String
  subject             String
  status              ProcessStatus @default(sin_analizar)
  /// Reanálisis automático cuando llegan mensajes nuevos a un hilo ya analizado
  seguimiento         Boolean       @default(false)
  /// Llegaron mensajes/adjuntos después del último análisis (y no hay seguimiento)
  tieneMensajesNuevos Boolean       @default(false)
  contentHash         String?
  lastMessageAt       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  account             MailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages            Message[]
  syntheses           Synthesis[]

  @@unique([accountId, conversationId])
}

model Message {
  id          String       @id @default(uuid())
  threadId    String
  graphId     String       @unique
  from        String
  to          String[]
  cc          String[]
  subject     String
  bodyText    String
  /// true si el remitente es el correo de la cuenta (mensaje enviado por mí)
  isFromMe    Boolean      @default(false)
  receivedAt  DateTime
  createdAt   DateTime     @default(now())
  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([threadId, receivedAt])
}

model Attachment {
  id         String        @id @default(uuid())
  messageId  String
  graphId    String?
  filename   String
  mimeType   String
  size       Int
  storageKey String
  sha256     String
  status     ProcessStatus @default(pendiente)
  createdAt  DateTime      @default(now())
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pages      OcrPage[]

  @@index([sha256])
}

model OcrPage {
  id           String      @id @default(uuid())
  attachmentId String
  /// Denormalizado de Attachment.sha256: un PDF repetido comparte un solo juego de páginas
  sha256       String
  pageNumber   Int
  imageKey     String
  width        Int
  height       Int
  text         String?
  /// Motor que produjo el OCR (local | textract)
  engine       String?
  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  regions      OcrRegion[]

  @@unique([attachmentId, pageNumber])
  @@unique([sha256, pageNumber])
}

model OcrRegion {
  id         String       @id @default(uuid())
  pageId     String
  /// Caja normalizada 0..1
  x          Float
  y          Float
  w          Float
  h          Float
  text       String
  confidence Float
  status     RegionStatus @default(ok)
  userText   String?
  /// Origen del texto vigente: ocr | vision | usuario
  source     String       @default("ocr")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  page       OcrPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status])
}

model Synthesis {
  id                   String   @id @default(uuid())
  threadId             String
  version              Int
  markdown             String
  inputHash            String
  /// Modelo LLM que generó el texto
  model                String?
  /// Plantilla usada (id y versión) al generar
  templateId           String?
  templateVersion      Int?
  /// Ids de TODOS los mensajes del hilo que cubre esta versión (acumulativo). "Mensajes nuevos" =
  /// mensajes del hilo cuyo id no está aquí. Vacío en versiones anteriores a la síntesis incremental.
  coveredMessageIds    Json     @default("[]")
  /// 'full' (hilo completo) | 'incremental' (síntesis previa + novedades)
  mode                 String   @default("full")
  /// Síntesis previa sobre la que se actualizó (solo mode = incremental)
  baseSynthesisId      String?
  /// Tokens estimados enviados al LLM (suma de llamadas) para auditar costo; sin contenido
  inputTokensEstimados Int?
  createdAt            DateTime @default(now())
  thread               Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, version])
}

model Template {
  id        String   @id @default(uuid())
  name      String
  /// Tipo de plantilla: 'resumen' (síntesis del ticket) | 'whatsapp' (formato del mensaje). Ver template-kinds.ts
  kind      String   @default("resumen")
  /// Versión incremental por kind; solo una fila activa a la vez por kind (las demás son historial)
  version   Int      @default(1)
  markdown  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
