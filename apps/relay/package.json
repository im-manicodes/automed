{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "auto-med relay: reenvía el celular al escritorio por un túnel saliente (sin base de datos)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "bootstrap:hash": "tsc -p tsconfig.build.json && node dist/bootstrap-hash.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
