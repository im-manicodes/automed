# Copiar al Droplet (p. ej. /root/automed.env, chmod 600) y pasarlo a bootstrap.sh. No subir a git.
# Formato KEY=valor, una por línea, SIN comillas ni espacios en los valores.
# Dokku guarda estos valores como config de la app `api`; GitHub Actions no los ve.
DOMAIN=automed.tudominio.com
LETSENCRYPT_EMAIL=tu@correo.com

# Clave y secreto de RustFS (también las usa la api). Largos y aleatorios: openssl rand -base64 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=automed

# Secretos de la app (openssl rand -base64 32 / 48)
TOKEN_ENC_KEY=
JWT_SECRET=

# Microsoft (Entra ID): redirect URI = https://<DOMAIN>/api/auth/callback
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://automed.tudominio.com/api/auth/callback

# Producción: Textract + Bedrock (credenciales AWS)
OCR_ENGINE=textract
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cualquier otra variable de .env.example (JOBS_*, SYNC_INTERVAL_MIN, SYNTH_MAX_INPUT_TOKENS, LLM_MODEL_*…)
# puede añadirse aquí: todo lo que no sea DOMAIN/LETSENCRYPT_EMAIL se guarda como config de la api.
