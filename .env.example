PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/automed?schema=public

# Almacenamiento S3 compatible (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=automed
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# Cifrado de tokens (AES-GCM, 32 bytes en base64)
TOKEN_ENC_KEY=

# Microsoft Graph (fase 2) — ver docs/entra-id-registro.md
# MS_TENANT_ID: GUID del tenant (o "common"/"organizations" si es multi-tenant)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback
SYNC_INTERVAL_MIN=5
# Opcional: restringe el login a este correo (si no, la primera cuenta que entre queda como la única)
ALLOWED_EMAIL=
# Opcional: secreto para firmar la cookie de sesión (si vacío se deriva de TOKEN_ENC_KEY)
SESSION_SECRET=

# Motores intercambiables
OCR_ENGINE=local        # local | textract
LLM_PROVIDER=anthropic  # anthropic | openai | bedrock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=us-east-1

# DATABASE_URL para docker compose (la API en contenedor llega al host)
DATABASE_URL_DOCKER=postgresql://USUARIO:CLAVE@host.docker.internal:5432/automed?schema=public

# Web (Vite, solo desarrollo local)
VITE_API_URL=http://localhost:3000
