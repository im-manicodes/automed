PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/automed?schema=public

# Almacenamiento S3 compatible (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=automed
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# Cifrado de tokens (AES-GCM, 32 bytes en base64)
TOKEN_ENC_KEY=

# Microsoft Graph (fase 2) — ver docs/entra-id-registro.md
# MS_TENANT_ID: "common" = cuentas de trabajo de cualquier inquilino + cuentas personales de Microsoft.
# No pongas un GUID salvo que quieras limitar el acceso a un solo inquilino ("organizations"/"consumers" también valen).
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback
SYNC_INTERVAL_MIN=5           # el sync solo descarga/guarda; el análisis (OCR/LLM) es solo bajo petición
# Sesión de la app (fase 8): login con correo + contraseña (usuarios con `pnpm --filter api user:create`).
# JWT_SECRET es OBLIGATORIO (≥ 32 caracteres; la API no arranca sin él): openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m            # duración del JWT de acceso (cookie HttpOnly)
JWT_REFRESH_TTL=30d           # duración del refresh token (rotativo)
# Cookies de sesión Secure: true|false la fuerza; vacío = se deduce de MS_REDIRECT_URI (https => Secure)
COOKIE_SECURE=

# Jobs / pipeline (fase 3, cola en PostgreSQL)
JOBS_ENABLED=true            # false desactiva el worker (útil en tests)
JOBS_CONCURRENCY=2           # trabajos simultáneos por proceso
JOBS_POLL_MS=1000            # polling de la cola
JOBS_MAX_ATTEMPTS=5          # intentos antes de quedar en 'error'
JOBS_BACKOFF_BASE_SEC=10     # backoff exponencial: base * 2^(intento-1)
JOBS_BACKOFF_MAX_SEC=3600    # tope del backoff
JOBS_LOCK_TIMEOUT_SEC=300    # un trabajo 'procesando' con lock más viejo se recupera
# Tests de integración opcionales (BD/esquema aparte con migraciones aplicadas): pnpm --filter api test:integration
# TEST_DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/automed?schema=automed_itest

# Seed de desarrollo (db:seed). SOLO desarrollo: se ignora/rechaza con NODE_ENV=production. Nunca uses una contraseña real.
# SEED_USER_EMAIL=
# SEED_USER_NAME=
# SEED_USER_PASSWORD=           # vacío a propósito: define una contraseña de prueba (>= 10 caracteres) solo en tu .env local

# Motores intercambiables
OCR_ENGINE=local        # local | textract
# OCR (fase 4)
OCR_RENDER_DPI=250                # resolución al rasterizar PDFs (200-300)
OCR_CONFIDENCE_THRESHOLD=0.85     # regiones con confianza menor quedan 'dudoso' (0..1)
OCR_VISION_RETRY=false            # true: relee con LLM de visión las regiones dudosas
OCR_VISION_ACCEPT_THRESHOLD=0.9   # confianza mínima de la relectura para pasar a 'ok'
OCR_VISION_MAX_REGIONS=30         # tope de relecturas por documento
OCR_LOCAL_URL=http://localhost:8000   # servicio services/ocr-local (OCR_ENGINE=local)
OCR_LOCAL_TIMEOUT_MS=120000
OCR_LOCAL_ENGINE=paddle           # paddle | tesseract (lo lee el servicio Python)
OCR_LANG=es                       # idioma PaddleOCR (servicio Python)
# PDF digital -> markdown sin OCR (servicio services/pdf-extract, PyMuPDF; las páginas escaneadas siguen por OCR)
# Imagen única de producción: carpeta del front compilado que sirve la propia API (la fija el Dockerfile; en dev déjala vacía).
# FRONTEND_BUILD_PATH=/app/frontend
PDF_TEXT_MODE=auto                # auto | off (off: todas las páginas por OCR, como antes)
PDF_EXTRACT_URL=http://localhost:8001   # en docker compose la api usa http://pdf-extract:8001 automáticamente
PDF_EXTRACT_TIMEOUT_MS=60000
PDF_TEXT_MIN_CHARS=60             # caracteres mínimos de texto para considerar digital una página
TEXTRACT_MODE=detect              # detect (DetectDocumentText) | analyze (AnalyzeDocument FORMS+TABLES)
# LLM / síntesis (fase 5)
# Las variables LLM_*, *_API_KEY, OLLAMA_BASE_URL, AWS_REGION y SYNTH_MAX_INPUT_TOKENS son valores POR DEFECTO:
# lo configurado en la web (asistente de bienvenida / Ajustes -> Inteligencia artificial) tiene prioridad.
LLM_PROVIDER=anthropic  # anthropic | openai | bedrock | ollama
# Perfiles de docker compose: `docker compose up` levanta ocr-local si OCR_ENGINE=local y
# ollama + ollama-pull si LLM_PROVIDER=ollama (otros valores no levantan nada extra).
# Debe ir DESPUES de OCR_ENGINE y LLM_PROVIDER (interpolación de compose); la define aquí tu .env.
COMPOSE_PROFILES=${OCR_ENGINE},${LLM_PROVIDER}
# Hot reload en Docker (SOLO desarrollo): descomenta esta línea en tu .env local para que `docker compose up`
# cargue docker-compose.dev.yml (api con nest --watch, web con Vite en http://localhost:5173). Déjala comentada
# en producción: allí solo se usa docker-compose.yml (imágenes de build, web en :8080).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# CHOKIDAR_USEPOLLING=true   # solo si el hot reload no detecta cambios (bind mounts sin inotify)
# --- Ollama (SOLO desarrollo/pruebas; producción: bedrock). Local y con GPU: el contenido sensible no sale de la máquina.
# Para usarlo: LLM_PROVIDER=ollama, LLM_MODEL_TEXT=qwen2.5vl:3b (con visión, ~3 GB; cabe en una GTX 1660 Ti de 6 GB)
# y SYNTH_MAX_INPUT_TOKENS=6000. Ignorado si LLM_PROVIDER no es ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1   # en docker compose la api usa http://ollama:11434/v1 automáticamente
OLLAMA_CONTEXT_LENGTH=8192                  # contexto de Ollama (por defecto 4096 truncaría); SYNTH_MAX_INPUT_TOKENS <= este valor menos margen
# Modelos (vacío = por defecto: anthropic claude-sonnet-5-5, bedrock anthropic.claude-sonnet-5-5, openai gpt-5, ollama qwen2.5vl:3b).
# En Bedrock usa el ID/perfil de inferencia disponible en tu región (p. ej. us.anthropic....).
LLM_MODEL_TEXT=
LLM_MODEL_VISION=       # vacío = LLM_MODEL_TEXT (relectura de recortes OCR)
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3       # reintentos con backoff ante 429/5xx/timeouts
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TEMPERATURE=0.2     # se omite en modelos que no la aceptan (Claude 5.x, GPT-5)
SYNTH_MAX_INPUT_TOKENS=60000   # con ollama baja a ~6000 (<= OLLAMA_CONTEXT_LENGTH menos margen); tope de entrada por llamada; sobre él se resume por tramos (map-reduce), también en modo incremental (síntesis previa + novedades)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock y Textract (credenciales AWS estándar: rol, perfil o AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
AWS_REGION=us-east-1

# DATABASE_URL para docker compose (la API en contenedor llega al host)
DATABASE_URL_DOCKER=postgresql://USUARIO:CLAVE@host.docker.internal:5432/automed?schema=public

# Web (Vite, solo desarrollo local)
VITE_API_URL=http://localhost:3000
